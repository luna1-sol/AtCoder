{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: build & run",
      "type": "shell",
      "command": "'${workspaceFolder}/run.sh' '${file}'",
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "C++: build & run (in.txt)",
      "type": "shell",
      "command": "'${workspaceFolder}/run.sh' '${file}' '${fileDirname}/in.txt'",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "C++: build (debug)",
      "type": "shell",
      "command": "mkdir -p '${workspaceFolder}/.bin' && g++-16 -std=c++23 -g -O0 -Wall -Wextra '${file}' -o '${workspaceFolder}/.bin/debug.out'",
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
